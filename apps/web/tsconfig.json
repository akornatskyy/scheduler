{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "strict": true,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "paths": {
      "$shared/*": ["./src/shared/*"],
      "$features/*": ["./src/features/*"]
    }
  }
}
